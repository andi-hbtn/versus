# ---- Contact form ----
# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=andi.bevapi@gmail.com

# SMTP account used to SEND the mail. This must be a real mailbox you own.
# For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and paste it into SMTP_PASS.
# The normal account password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your.sender@gmail.com
SMTP_PASS=your-16-char-app-password
